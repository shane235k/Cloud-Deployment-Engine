pipeline {
    agent any

    parameters {
        choice(name: 'NODE_ROLE', choices: ['SERVER', 'AGENT'], description: 'K3s cluster role for this EC2 instance')
        string(name: 'PROVISION_BASE', defaultValue: 'false', description: 'Whether to provision/verify Base infrastructure (true for first server, false for agents)')
        string(name: 'K3S_SERVER_IP', defaultValue: '', description: 'Private IP of existing K3s Control Plane Server (required for AGENT)')
        string(name: 'TARGET_WORKSPACE', defaultValue: '', description: 'Terraform target workspace name (e.g. server-1, worker-1)')
    }

    environment {
        // Backend API
        BACKEND_URL = 'http://host.docker.internal:30007'

        // Terraform Directories
        TF_BASE_DIR   = '/var/jenkins_home/terraform/base'
        TF_SERVER_DIR = '/var/jenkins_home/terraform/server'

        // SSH User
        SSH_USER = 'ubuntu'

        // AWS
        AWS_PAGER                    = ''
        AWS_SHARED_CREDENTIALS_FILE  = '/var/jenkins_home/.aws/credentials'
        AWS_CONFIG_FILE              = '/var/jenkins_home/.aws/config'
        AWS_DEFAULT_REGION           = 'us-east-2'
    }

    stages {
        stage('Verify AWS Credentials') {
            steps {
                sh '''
                    IDENTITY=$(aws sts get-caller-identity 2>&1)
                    EXIT_CODE=$?

                    ACCOUNT_ID=$(echo "$IDENTITY" | grep -o '"Account": "[^"]*"' | cut -d'"' -f4)
                    ARN=$(echo "$IDENTITY" | grep -o '"Arn": "[^"]*"' | cut -d'"' -f4)
                    USER_ID=$(echo "$IDENTITY" | grep -o '"UserId": "[^"]*"' | cut -d'"' -f4)

                    if [ $EXIT_CODE -ne 0 ]; then
                        echo "AWS credential verification FAILED. Raw error: $IDENTITY"
                        exit 1
                    else
                        echo "AWS credentials verified successfully. Account ID: $ACCOUNT_ID | IAM ARN: $ARN | User ID: $USER_ID | Region: $AWS_DEFAULT_REGION"
                    fi
                '''
            }
        }

        stage('Provision Base Infrastructure') {
            when {
                expression {
                    return params.PROVISION_BASE == 'true' || params.NODE_ROLE == 'SERVER'
                }
            }
            steps {
                sh '''
                    echo "Initialising Base Terraform in ${TF_BASE_DIR}..."
                    cd "${TF_BASE_DIR}"

                    terraform init -input=false

                    OUTPUTS=$(terraform output -json 2>/dev/null || echo "{}")

                    if [ "${PROVISION_BASE}" = "true" ] || [ "${OUTPUTS}" = "{}" ]; then
                        echo "Executing Base terraform apply (PROVISION_BASE=${PROVISION_BASE})..."
                        terraform apply -auto-approve -input=false
                        echo "Base shared infrastructure provisioned successfully."
                    else
                        echo "Base shared infrastructure already provisioned with valid outputs. Skipping Base terraform apply."
                    fi
                '''
            }
        }

        stage('Provision Server Infrastructure') {
            steps {
                sh '''
                    echo "Initialising Server Terraform in ${TF_SERVER_DIR}..."
                    cd "${TF_SERVER_DIR}"

                    WORKSPACE="${TARGET_WORKSPACE}"
                    if [ -z "${WORKSPACE}" ] || [ "${WORKSPACE}" = "default" ]; then
                        echo "ERROR: TARGET_WORKSPACE parameter is missing, empty, or set to 'default'. EC2 provisioning inside default workspace is strictly prohibited."
                        exit 1
                    fi

                    terraform init -input=false

                    echo "Selected target workspace: ${WORKSPACE}"

                    if terraform workspace list | grep -q "[[:space:]]*${WORKSPACE}$"; then
                        echo "Workspace '${WORKSPACE}' already exists. Selecting workspace..."
                        terraform workspace select "${WORKSPACE}"
                        WS_STATUS="reused"
                    else
                        echo "Workspace '${WORKSPACE}' does not exist. Creating new workspace..."
                        terraform workspace new "${WORKSPACE}"
                        WS_STATUS="created"
                    fi

                    ACTIVE_WS=$(terraform workspace show)
                    if [ "${ACTIVE_WS}" = "default" ]; then
                        echo "ERROR: Active workspace resolved to 'default'. Provisioning in default workspace is strictly prohibited."
                        exit 1
                    fi

                    echo "Current active workspace before terraform apply: ${ACTIVE_WS} (Status: ${WS_STATUS}) | Role: ${NODE_ROLE}"

                    if [ "${NODE_ROLE}" = "SERVER" ]; then
                        echo "Provisioning K3s Control Plane Server..."
                        terraform apply -auto-approve -input=false -var="is_control_plane=true"
                    else
                        echo "Provisioning K3s Worker Agent node..."
                        if [ -z "${K3S_SERVER_IP}" ]; then
                            echo "ERROR: K3S_SERVER_IP is required when NODE_ROLE is AGENT"
                            exit 1
                        fi
                        terraform apply -auto-approve -input=false -var="is_control_plane=false" -var="k3s_server_private_ip=${K3S_SERVER_IP}"
                    fi

                    echo "Server EC2 infrastructure provisioned successfully via Terraform in workspace '${ACTIVE_WS}'."
                '''
            }
        }

        stage('Get EC2 Outputs') {
            steps {
                script {
                    env.INSTANCE_ID = sh(
                        script: '''
                            cd "${TF_SERVER_DIR}"
                            WORKSPACE="${TARGET_WORKSPACE}"
                            if [ -z "${WORKSPACE}" ] || [ "${WORKSPACE}" = "default" ]; then
                                echo "ERROR: Invalid workspace name" && exit 1
                            fi
                            terraform workspace select "${WORKSPACE}" >/dev/null 2>&1 || true
                            terraform output -raw instance_id
                        ''',
                        returnStdout: true
                    ).trim()

                    env.PRIVATE_IP = sh(
                        script: '''
                            cd "${TF_SERVER_DIR}"
                            WORKSPACE="${TARGET_WORKSPACE}"
                            if [ -z "${WORKSPACE}" ] || [ "${WORKSPACE}" = "default" ]; then
                                echo "ERROR: Invalid workspace name" && exit 1
                            fi
                            terraform workspace select "${WORKSPACE}" >/dev/null 2>&1 || true
                            terraform output -raw private_ip
                        ''',
                        returnStdout: true
                    ).trim()

                    env.PUBLIC_IP = sh(
                        script: '''
                            cd "${TF_SERVER_DIR}"
                            WORKSPACE="${TARGET_WORKSPACE}"
                            if [ -z "${WORKSPACE}" ] || [ "${WORKSPACE}" = "default" ]; then
                                echo "ERROR: Invalid workspace name" && exit 1
                            fi
                            terraform workspace select "${WORKSPACE}" >/dev/null 2>&1 || true
                            terraform output -raw public_ip 2>/dev/null || echo ""
                        ''',
                        returnStdout: true
                    ).trim()
                }

                sh '''
                    echo "EC2 Instance ID: ${INSTANCE_ID} | Private IP: ${PRIVATE_IP} | Public IP: ${PUBLIC_IP} | Workspace: ${TARGET_WORKSPACE} | Role: ${NODE_ROLE}"
                '''
            }
        }

        stage('Wait for AWS Status Checks') {
            steps {
                sh '''
                    echo "Waiting for EC2 instance ${INSTANCE_ID} to pass AWS hardware and OS status checks..."
                    aws ec2 wait instance-status-ok --instance-ids "${INSTANCE_ID}"
                    echo "EC2 instance ${INSTANCE_ID} passed AWS status checks."
                '''
            }
        }

        stage('Verify Node Readiness') {
            steps {
                sh '''
                    echo "EC2 instance ${INSTANCE_ID} is active in public subnet."
                    echo "Public IP: ${PUBLIC_IP} | Private IP: ${PRIVATE_IP} | Role: ${NODE_ROLE} | Workspace: ${TARGET_WORKSPACE}"
                    echo "K3s node bootstrap is executing internally via IMDSv2 and SSM join token."
                    echo "Initial server registration status will be UNMONITORED until SSH telemetry is established."

                    if [ "${NODE_ROLE}" = "AGENT" ] && [ -n "${K3S_SERVER_IP}" ]; then
                        echo "Configuring K3s cluster kubeconfig on Agent node (${PUBLIC_IP})..."
                        SERVER_PUBLIC_IP=$(python3 -c "
import urllib.request, json
try:
    req = urllib.request.urlopen('${BACKEND_URL}/servers')
    data = json.loads(req.read().decode())
    for s in data:
        if s.get('isControlPlane') or s.get('nodeRole') == 'SERVER':
            print(s.get('publicIp', ''))
            break
except Exception as e:
    print('')
")
                        if [ -n "${SERVER_PUBLIC_IP}" ]; then
                            echo "Found K3s Control Plane Server at ${SERVER_PUBLIC_IP}. Syncing kubeconfig..."
                            ssh -o StrictHostKeyChecking=no -i /var/jenkins_home/p377-key.pem ${SSH_USER}@${SERVER_PUBLIC_IP} "sudo cat /etc/rancher/k3s/k3s.yaml" | \
                                sed "s/127.0.0.1/${K3S_SERVER_IP}/g" > /tmp/agent-k3s.yaml
                            scp -o StrictHostKeyChecking=no -i /var/jenkins_home/p377-key.pem /tmp/agent-k3s.yaml ${SSH_USER}@${PUBLIC_IP}:/tmp/k3s.yaml
                            ssh -o StrictHostKeyChecking=no -i /var/jenkins_home/p377-key.pem ${SSH_USER}@${PUBLIC_IP} "sudo mkdir -p /etc/rancher/k3s && sudo mv /tmp/k3s.yaml /etc/rancher/k3s/k3s.yaml && sudo chmod 644 /etc/rancher/k3s/k3s.yaml"
                            rm -f /tmp/agent-k3s.yaml
                            echo "Kubeconfig successfully configured on Agent node."
                        fi
                    fi
                '''
            }
        }

        stage('Register Server') {
            steps {
                sh '''
                    echo "Registering node ${INSTANCE_ID} (${PRIVATE_IP}, Role: ${NODE_ROLE}) with backend registry..."

                    PAYLOAD=$(python3 -c "import json; print(json.dumps({
                        'name': '${INSTANCE_ID}',
                        'instanceId': '${INSTANCE_ID}',
                        'workspace': '${TARGET_WORKSPACE}',
                        'privateIp': '${PRIVATE_IP}',
                        'publicIp': '${PUBLIC_IP}',
                        'nodeRole': '${NODE_ROLE}',
                        'isControlPlane': '${NODE_ROLE}' == 'SERVER',
                        'sshUser': '${SSH_USER}',
                        'clusterType': 'k3s',
                        'status': 'UNMONITORED'
                    }))")

                    RESPONSE=$(curl -s -X POST ${BACKEND_URL}/servers/register \
                        -H "Content-Type: application/json" \
                        -d "$PAYLOAD")

                    echo "Server registered successfully. Response: $RESPONSE"
                '''
            }
        }

        stage('Attach Node to ALB Target Group') {
            steps {
                sh '''
                    echo "Retrieving ALB Target Group ARN from Base Terraform..."
                    TG_ARN=$(terraform -chdir="${TF_BASE_DIR}" output -raw alb_target_group_arn 2>/dev/null || echo "")
                    if [ -n "${TG_ARN}" ] && [ "${TG_ARN}" != "None" ]; then
                        echo "Registering instance ${INSTANCE_ID} on port 80 with Target Group: ${TG_ARN}..."
                        aws elbv2 register-targets --target-group-arn "${TG_ARN}" --targets Id="${INSTANCE_ID}",Port=80 || true
                        echo "Target registration command dispatched."
                    else
                        echo "Warning: No ALB Target Group ARN found in Base Terraform outputs. Skipping ALB attachment."
                    fi
                '''
            }
        }
    }

    post {
        success {
            echo "Provision Server pipeline completed successfully for workspace '${TARGET_WORKSPACE}' (Role: ${NODE_ROLE})."
        }

        failure {
            echo "Provision Server pipeline failed for workspace '${TARGET_WORKSPACE}' (Role: ${NODE_ROLE})."
        }
    }
}
